{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.mclawai.mclaw",
  "asar": true,
  "forceCodeSigning": true,
  "afterSign": "scripts/after-sign-notarize.cjs",
  "afterAllArtifactBuild": "scripts/after-all-artifact-build.cjs",
  "directories": {
    "output": "release/${env.QCLAW_DISPLAY_VERSION}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "extraResources": [
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "NOTICE",
      "to": "NOTICE"
    },
    {
      "from": "src/assets/logo.png",
      "to": "app-icon.png"
    }
  ],
  "mac": {
    "icon": "build/icon.icns",
    "category": "public.app-category.developer-tools",
    "artifactName": "Mclaw_${env.QCLAW_DISPLAY_VERSION}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "strictVerify": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist",
    "notarize": false,
    "target": [
      "dmg",
      "zip"
    ],
    "extraResources": [
      {
        "from": "resources/openclaw-bundle",
        "to": "openclaw-bundle"
      }
    ]
  },
  "dmg": {
    "writeUpdateInfo": true,
    "sign": false,
    "format": "UDZO"
  },
  "win": {
    "icon": "public/favicon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Mclaw_${env.QCLAW_DISPLAY_VERSION}.${ext}",
    "extraResources": [
      {
        "from": "resources/openclaw-bundle/manifest.json",
        "to": "openclaw-bundle/manifest.json"
      },
      {
        "from": "resources/openclaw-bundle/README.md",
        "to": "openclaw-bundle/README.md"
      },
      {
        "from": "resources/openclaw-bundle/managed-plugins",
        "to": "openclaw-bundle/managed-plugins"
      },
      {
        "from": "resources/openclaw-bundle/runtime/windows-x64",
        "to": "openclaw-bundle/runtime/windows-x64"
      },
      {
        "from": "resources/dev-tools-bundle/windows-x64",
        "to": "dev-tools-bundle/windows-x64"
      },
      {
        "from": "node-v24.14.1-win-x64/node-v24.14.1-win-x64",
        "to": "openclaw-bundle/runtime/windows-x64",
        "filter": [
          "npm",
          "npm.cmd",
          "npm.ps1",
          "npx",
          "npx.cmd",
          "npx.ps1",
          "node_modules/npm/**/*"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "public/favicon.ico",
    "uninstallerIcon": "public/favicon.ico",
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "generic",
    "channel": "latest",
    "url": "https://example.invalid/mclaw/updates/latest"
  }
}
